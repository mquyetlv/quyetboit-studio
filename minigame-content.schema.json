{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quyetboit.local/schemas/minigame-content.schema.json",
  "title": "QuyetBoIT Studio English Minigame Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "topic", "words"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "topic": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vietnamese",
          "english",
          "ipa",
          "wordType",
          "example",
          "exampleVietnamese"
        ],
        "properties": {
          "vietnamese": { "type": "string" },
          "english": { "type": "string" },
          "ipa": { "type": "string" },
          "wordType": { "type": "string" },
          "example": { "type": "string" },
          "exampleVietnamese": { "type": "string" }
        }
      }
    }
  }
}
